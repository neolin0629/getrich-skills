    "P2": {
      "name": "空转与预告",
      "severity": "mid",
      "hint": "直接开始说。",
      "words": [
        "话不多说", "废话不多说", "接下来我们", "下面我们", "让我们一起", "让我们来看",
        "我们先来看", "先说结论", "带你了解", "带你搞懂", "一文读懂", "看完你就明白",
        "深入探讨一下", "展开聊聊", "好了", "闲言少叙", "言归正传"
