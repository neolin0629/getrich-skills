    "P3": {
      "name": "挑战与展望模板",
      "severity": "high",
      "hint": "具体说发生了什么。不做「一方面……另一方面……展望未来」的包装。",
      "words": [
        "尽管面临", "尽管存在这些", "虽然仍面临", "面临诸多挑战",
        "展望未来", "放眼未来", "未来可期", "值得期待", "任重道远", "道阻且长",
        "机遇与挑战并存", "危中有机", "有望迎来", "有望实现"
      ]
    },

    "P4": {
      "name": "结尾祝福与通用积极收尾",
      "severity": "high",
      "hint": "删掉最后一段再读一遍，文章通常已经结束了。",
      "words": [
        "愿你", "愿我们", "祝你", "你值得", "共勉", "与君共勉", "一起加油", "一起变好",
        "希望对你有帮助", "希望这篇", "如果你也", "愿每一个", "点亮在看", "转发给",
        "未来可期", "行则将至", "终将", "终会", "慢慢来", "一切都会好起来"
      ]
