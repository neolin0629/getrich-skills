  "regex_rules": {
    "P2_prompt_colon": {
      "name": "提示冒号前的空转候选",
      "severity": "low",
      "scope": "prose",
      "hint": "只核对提示词是否重复或空泛；保留强调、定义、判断范围及冒号后的全部信息，不见冒号就删。",
      "patterns": [
        {
          "pattern": "(?<![^。！？!?；;\\r\\n])(?:一句话总结|简单来说|核心是|结论是|重点是|关键是)[ \\t]*[：:]",
          "desc": "句首提示词加冒号，需结合上下文判断是否可省略"
        }
      ]
    },
    "S3": {
      "name": "「不是 X 是 Y」高密度",
      "severity": "high",
      "hint": "任一 800 字正文窗口至少 3 次才提示重复；根据论证需要保留，不设全文一次的硬上限。",
      "density_per_800": 3,
      "patterns": [
        {
          "pattern": "不(是|只是|仅仅是|仅是)[^。！？\\r\\n]{1,30}(，|；)?(而)?是",
          "desc": "不是 X 是 Y"
        },
        {
          "pattern": "不仅[^。！？\\r\\n]{1,30}(而且|还|更)",
          "desc": "不仅……而且"
        },
        {
          "pattern": "与其说[^。！？\\r\\n]{1,30}不如说",
          "desc": "与其说……不如说"
        },
        {
          "pattern": "表面上[^。！？\\r\\n]{1,30}(实际上|本质上|真正)",
          "desc": "表面上……实际上"
        }
      ]
    },
    "S4": {
      "name": "系动词回避",
      "severity": "mid",
      "hint": "仅在原意等价时简化；保留身份、过程、结果和评价力度，不把「成为」「堪称」机械改为「是」。",
      "patterns": [
        {
          "pattern": "作为[^，。！？]{2,16}(，|的)",
          "desc": "作为……"
        },
        {
          "pattern": "堪称[^，。！？]{2,14}",
          "desc": "堪称……"
        },
        {
          "pattern": "成为[^，。！？]{2,14}的(存在|标杆|典范|代名词)",
          "desc": "成为……的存在"
        },
        {
          "pattern": "扮演(着)?[^，。！？]{2,12}的角色",
          "desc": "扮演……的角色"
        }
      ]
    },
    "S5": {
      "name": "分词尾巴式肤浅分析",
      "severity": "low",
      "hint": "只改没有依据或新增信息的评价尾句；具体动作、用途和因果关系应保留。",
      "patterns": [
        {
          "pattern": "，(彰显|体现|反映|凸显|展现|印证|折射|昭示|诠释|见证)(了|出|着)[^。！？]{2,40}[。！？]",
          "desc": "，彰显了……。"
        },
        {
          "pattern": "，为[^。！？\\n]{2,20}(?:奠定了?(?:坚实)?基础|注入了?(?:新)?活力|铺平了?道路)[。！？]",
          "desc": "空泛评价尾句候选"
        },
        {
          "pattern": "，成为[^。！？]{2,20}的(缩影|写照|注脚|典型|标志)[。！？]",
          "desc": "，成为……的缩影。"
        },
        {
          "pattern": "，(标志|意味)着[^。！？]{2,30}[。！？]",
          "desc": "，标志着……。"
        }
      ]
    },
    "S6": {
      "name": "虚假范围",
      "severity": "mid",
      "hint": "直接列你真的要讲的东西。",
      "patterns": [
        {
          "pattern": "从[^，。！？0-9]{2,12}到[^，。！？0-9]{2,12}(，|、)从[^，。！？0-9]{2,12}到[^，。！？0-9]{2,12}",
          "desc": "从 X 到 Y，从 A 到 B"
        }
      ]
    },
    "S8": {
      "name": "格言公式",
      "severity": "low",
      "hint": "仅提示比喻候选；准确且有用途的比喻可保留，不要补编经历来替换。",
      "patterns": [
        {
          "pattern": "[^，。！？]{2,10}是[^，。！？]{2,10}的(语言|货币|镜子|底色|尺度|注脚|一部分|另一面)",
          "desc": "X 是 Y 的 Z"
        },
        {
          "pattern": "[^，。！？]{2,10}不是[^，。！？]{2,10}，(而)?是[^，。！？]{0,10}(镜子|底色|尺度|注脚|学费|货币)[。！？]",
          "desc": "X 不是 Y，是比喻性结论"
        },
        {
          "pattern": "(时间|市场|人性|认知|复利)是最好的[^，。！？]{2,10}",
