    "R1_uncertainty_markers": {
      "name": "不确定表达（这是要保留的，不是要删的）",
      "severity": "low",
      "hint": "观点、经验或分析类内容应如实写明判断边界；没有真实不确定性时不要硬加。",
      "is_positive_signal": true,
      "words": [
        "我不确定", "不太确定", "不确定", "我也不知道", "我不知道",
        "没想清楚", "没想明白", "没搞清楚", "没搞懂", "说不好", "说不上来",
        "我没查到", "查不到", "没查出来", "没找到", "存疑", "待验证", "还没验证",
        "我猜", "可能是我错了", "我原来以为", "本来以为", "后来发现", "改了主意",
        "会失效", "不适用", "样本外", "这块我不熟", "拿不准", "半信半疑",
        "没法判断", "很难说", "不好说", "是估的", "是拍的", "存在疑问", "有待观察"
      ]
