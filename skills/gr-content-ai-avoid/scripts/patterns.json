  "regex_rules": {
    "S1": {
      "name": "三段式与匀速排比",
      "severity": "high",
      "hint": "真的只有两项写两项，四项写四项。",
      "patterns": [
        { "pattern": "(?<![^，。！？；\\n])[^，。！？、；\\n]+(?:、[^，。！？、；\\n]+){2,}", "desc": "顿号三项", "check": "three_similar_items" }
      ]
    },
    "S3": {
      "name": "「不是 X 是 Y」高密度",
      "severity": "high",
      "hint": "全文最多一次。任一 800 字正文窗口内至少 3 次才判定，重叠句式只计一次。",
      "density_per_800": 3,
      "patterns": [
        { "pattern": "不(是|只是|仅仅是|仅是)[^。！？]{1,30}(，|；)?(而)?是", "desc": "不是 X 是 Y" },
        { "pattern": "不仅[^。！？]{1,30}(而且|还|更)", "desc": "不仅……而且" },
        { "pattern": "与其说[^。！？]{1,30}不如说", "desc": "与其说……不如说" },
        { "pattern": "表面上[^。！？]{1,30}(实际上|本质上|真正)", "desc": "表面上……实际上" }
      ]
    },
    "S4": {
      "name": "系动词回避",
      "severity": "mid",
      "hint": "能用「是」就用「是」。",
      "patterns": [
        { "pattern": "作为[^，。！？]{2,16}(，|的)", "desc": "作为……" },
        { "pattern": "堪称[^，。！？]{2,14}", "desc": "堪称……" },
        { "pattern": "成为[^，。！？]{2,14}的(存在|标杆|典范|代名词)", "desc": "成为……的存在" },
        { "pattern": "扮演(着)?[^，。！？]{2,12}的角色", "desc": "扮演……的角色" }
      ]
    },
    "S5": {
      "name": "分词尾巴式肤浅分析",
      "severity": "high",
      "hint": "句号打在那儿。尾巴里有信息就拆成独立一句，没有就删。",
      "patterns": [
        { "pattern": "，(彰显|体现|反映|凸显|展现|印证|折射|昭示|诠释|见证)(了|出|着)[^。！？]{2,40}[。！？]", "desc": "，彰显了……。" },
        { "pattern": "，为[^。！？]{2,20}(奠定|提供|创造|注入|铺平)(了)?[^。！？]{0,12}[。！？]", "desc": "，为……奠定了基础。" },
        { "pattern": "，成为[^。！？]{2,20}的(缩影|写照|注脚|典型|标志)[。！？]", "desc": "，成为……的缩影。" },
        { "pattern": "，(标志|意味)着[^。！？]{2,30}[。！？]", "desc": "，标志着……。" },
        { "pattern": "，(确保|使得|让)[^。！？]{2,30}(得以|能够)[^。！？]{0,20}[。！？]", "desc": "，确保……得以……。" }
      ]
    },
    "S6": {
      "name": "虚假范围",
      "severity": "mid",
      "hint": "直接列你真的要讲的东西。",
      "patterns": [
        { "pattern": "从[^，。！？0-9]{2,12}到[^，。！？0-9]{2,12}(，|、)从[^，。！？0-9]{2,12}到[^，。！？0-9]{2,12}", "desc": "从 X 到 Y，从 A 到 B" }
      ]
    },
    "S8": {
      "name": "格言公式",
      "severity": "high",
      "hint": "说回那个具体的判断。",
      "patterns": [
        { "pattern": "[^，。！？]{2,10}是[^，。！？]{2,10}的(语言|货币|镜子|底色|尺度|注脚|一部分|另一面)", "desc": "X 是 Y 的 Z" },
        { "pattern": "[^，。！？]{2,10}不是[^，。！？]{2,10}，(而)?是[^，。！？]{0,10}(镜子|底色|尺度|注脚|学费|货币)[。！？]", "desc": "X 不是 Y，是比喻性结论" },
        { "pattern": "(时间|市场|人性|认知|复利)是最好的[^，。！？]{2,10}", "desc": "X 是最好的 Y" },
        { "pattern": "[^，。！？]{2,12}的(底层逻辑|第一性原理|本质)[是在]", "desc": "……的底层逻辑是" }
      ]
    },
    "P1": {
      "name": "开头三件套",
      "severity": "high",
      "hint": "从你真正想说的那件事开始。不卖焦虑，不承诺收获。",
      "scope": "head",
      "head_chars": 150,
      "patterns": [
        { "pattern": "你是不是(也)?(经常|总是|常常|遇到过)", "desc": "钩子：你是不是经常……" },
        { "pattern": "有没有(发现|想过|遇到过)", "desc": "钩子：有没有发现……" },
        { "pattern": "(为什么|凭什么)[^。！？]{2,20}(却|但)[^。！？]{2,20}[？?]", "desc": "钩子：为什么 X 却 Y？" },
        { "pattern": "(读完|看完)(这篇|本文|这条)[^。！？]{0,20}(你将|你会|就能|你就)", "desc": "承诺：读完你将……" },
        { "pattern": "(其实|真相是|问题(就)?出在)[^。！？]{2,20}", "desc": "痛点归因：其实是因为……" },
        { "pattern": "(今天|本文|这篇)(就)?(来|和你|跟大家)(聊|说|讲|分享)", "desc": "预告式开场" }
      ]
    },
    "P4_tail": {
      "name": "结尾套话（尾部扫描）",
      "severity": "high",
      "scope": "tail",
      "tail_chars": 200,
      "patterns": [
        { "pattern": "(愿|祝|望)[^。！？]{2,20}[。！？]?$", "desc": "祝福式收尾" }
      ]
    },
    "P5": {
      "name": "结论包装成协议",
      "severity": "mid",
      "hint": "议论类内容别硬凑清单。",
      "scope": "tail",
      "tail_chars": 400,
      "patterns": [
        { "pattern": "([三四五六]|[3-6])(条|个|点|大)(原则|逻辑|建议|启示|要点|心法|铁律|法则)", "desc": "N 条原则" },
        { "pattern": "记住(这)?[三四五六3-6](点|条|个)", "desc": "记住这几点" }
      ]
    },
    "P6": {
      "name": "内联小标题竖排列表",
      "severity": "mid",
      "hint": "写成连贯段落，或去掉粗体标题只留内容。",
      "line_patterns": [
        { "pattern": "^\\s*[-*+]\\s*\\*\\*[^*]{1,14}\\*\\*\\s*[：:]", "desc": "- **标题：** 内容" },
        { "pattern": "^\\s*[-*+]\\s*\\*\\*[^*]{1,14}[：:]\\*\\*", "desc": "- **标题：** 内容" }
      ],
      "min_consecutive": 3
    },
    "R2": {
      "name": "伪精确情绪细节",
      "severity": "high",
      "hint": "没量过的时间别写具体数字。",
      "patterns": [
        { "pattern": "\\d+\\.\\d+\\s*秒", "desc": "小数秒" },
        { "pattern": "(那一?(瞬间|刻|秒)|停顿了)[^。！？]{0,12}\\d+\\s*秒", "desc": "情绪场景里的秒数" }
      ]
    },
    "R4": {
      "name": "虚假的「我有个朋友」",
      "severity": "high",
      "hint": "想不起细节就换成自己的真实经历。",
      "patterns": [
        { "pattern": "我(有)?(一)?个(朋友|同事|读者|学员|客户)", "desc": "我有个朋友" },
        { "pattern": "(认识|遇到过)(一)?个(人|朋友|老板)", "desc": "认识一个人" }
      ]
    },
    "R5": {
      "name": "用身体感受替代论证",
      "severity": "mid",
      "patterns": [
        { "pattern": "身体(会|早就|自然会)?(给出|知道|告诉)", "desc": "身体会给出答案" },
        { "pattern": "你(会|能)感觉到", "desc": "你会感觉到" },
        { "pattern": "(那种感觉|直觉)(是)?骗不了(人|你)", "desc": "感觉骗不了人" }
      ]
    }
  },

  "metrics": {
    "S2_sentence_cv": {
      "name": "句长变异系数",
      "severity": "mid",
      "hint": "加一句 2–5 字的短句，或一句 40 字以上的长句。",
      "warn_below": 0.35,
      "strong_below": 0.25,
      "min_sentences": 8
    },
    "S7_punchline_rate": {
      "name": "段末金句率",
      "severity": "mid",
      "hint": "全文最多一两个爆发的句子，其他段落让它自然结束。",
      "warn_above": 0.6,
      "min_paragraphs": 4
    },
    "S7_staccato_run": {
      "name": "连续短句",
      "severity": "mid",
      "hint": "单句强调可以，连打三四句就是在演。",
      "max_len": 8,
      "min_run": 3
    },
    "F1_dash_per_1k": {
      "name": "破折号密度",
      "severity": "mid",
      "hint": "优先换成句号、逗号、冒号、括号。",
      "warn_above": 2.0,
      "min_allowed_count": 1
    },
    "F2_bold_per_1k": {
      "name": "粗体密度",
      "severity": "mid",
      "hint": "一屏内最多一处粗体。",
      "warn_above": 6.0,
      "min_allowed_count": 1,
      "genre_override": { "xhs-short": 12.0, "xhs-long": 12.0 }
    },
    "F3_emoji_per_1k": {
      "name": "emoji 密度",
      "severity": "mid",
      "hint": "删掉。AI 高频的 🚀 💡 ✅ 📌 🔥 尤其显眼。",
      "warn_above": 2.0
    },
    "W1_per_1k": { "name": "AI 高频词密度", "severity": "high", "warn_above": 2.0, "min_allowed_count": 2 },
    "R1_uncertainty_count": {
      "name": "不确定表达数量",
      "severity": "high",
      "hint": "量化分析应如实写明样本、场景或方法边界；不要为了过检制造犹豫。",
      "warn_below": 1,
      "min_chars": 400,
      "enforce_genres": ["quant"]
    }
  },

  "genres": {
    "default":   { "strict": [], "skip": [] },
    "wechat":    { "strict": ["S7_punchline_rate", "P5", "C7"], "skip": [] },
    "xhs-short": { "strict": ["P1", "P4", "C9"], "skip": ["S2_sentence_cv", "F3_emoji_per_1k", "S7_punchline_rate"] },
    "xhs-long":  { "strict": ["P1", "P4"], "skip": ["F3_emoji_per_1k", "P6"] },
    "weibo":     { "strict": ["P1", "P4"], "skip": ["S2_sentence_cv", "S7", "P6"] },
    "zhihu":     { "strict": ["C5", "C2"], "skip": [] },
    "video":     { "strict": ["P1", "W3"], "skip": ["S7_punchline_rate", "S7_staccato_run", "P2"] },
    "persona":   { "strict": ["R2", "R4", "P4"], "skip": ["S2_sentence_cv", "F3_emoji_per_1k"] },
    "copy":      { "strict": ["C9", "C5"], "skip": ["S7_punchline_rate", "R1_uncertainty_count"] },
    "quant":     { "strict": ["C5", "F5", "R1_uncertainty_count", "C7"], "skip": [] },
    "academic":  { "strict": ["W1", "W2", "S5", "F1_dash_per_1k", "C5"], "skip": ["C4", "S7_punchline_rate", "S7_staccato_run", "R1_uncertainty_count", "R2", "R4", "R5", "P5"] }
  }
}
