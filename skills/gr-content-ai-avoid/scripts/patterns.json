        "值得注意的是", "需要指出的是", "不难看出", "由此可见", "由此可以看出", "综上所述",
        "总而言之", "总的来说", "整体而言", "总体而言", "换句话说", "换言之", "简而言之",
        "与此同时", "更重要的是", "更为重要的是", "另一方面", "在某种程度上", "从某种意义上",
        "可以说", "毫无疑问", "无疑", "深入探讨", "深入剖析", "深入分析", "深刻理解",
        "彰显", "凸显", "体现出", "反映出", "折射出", "印证了", "昭示",
        "至关重要", "举足轻重", "不可或缺", "不容忽视", "尤为重要", "关键所在",
        "旨在", "致力于", "着力", "聚焦于", "锚定", "擘画", "赋予",
        "打造", "助力", "赋能", "护航", "加持", "驱动着", "引领",
        "丰富的", "多元的", "全方位", "多维度", "系统性地", "有机结合",
        "背景下", "浪潮下", "格局", "版图", "生态位", "叙事",
        "共同构成", "构成了", "形成了合力", "相辅相成", "相得益彰"
      ]
    },

    "W2": {
      "name": "翻译腔",
      "severity": "mid",
      "hint": "问自己「我嘴上会这么说吗」。不会就改。",
      "words": [
        "作为一名", "作为一个", "作为一种", "作为一项",
        "关于这一点", "关于这个问题", "基于此", "基于以上", "基于这一",
        "在这个时间点", "在当前时间点", "就……而言", "就此而言",
        "起到了", "起着", "发挥着", "扮演着", "承担着",
        "具备了", "具有着", "拥有着",
        "的事实是", "的一个事实", "值得一提的是",
        "在某些情况下", "在大多数情况下", "在这种情况下",
        "对其进行", "予以", "加以"
      ],
      "regex": [
        { "pattern": "对[^，。！？]{1,14}进行(了)?[一二三四五六七八九十]?[次遍种个]?", "desc": "对……进行……" },
        { "pattern": "[^，。！？]{1,10}的能力", "desc": "具备……的能力" },
        { "pattern": "起到了[^，。！？]{1,12}的作用", "desc": "起到了……的作用" }
      ]
    },

    "W3": {
      "name": "连接词",
      "severity": "mid",
      "hint": "写完数一遍，删掉一半。",
      "min_allowed_count": 1,
      "density_per_sentence": { "default": 0.25, "video": 0.15, "academic": 0.35, "persona": 0.5 },
      "words": [
        "然而", "但是", "不过", "因此", "所以说", "于是", "此外", "另外",
        "首先", "其次", "再次",
        "事实上", "实际上", "而事实上", "与此同时", "同时", "并且", "而且",
        "尽管如此", "即便如此", "尽管", "虽然", "不仅如此", "更进一步",
        "值得注意的是", "需要强调的是", "由此", "从而", "进而", "综上"
      ],
      "regex": [
        { "pattern": "(?:^|[。！？；\\n])[ \\t]*(第一|第二|第三|最后)(?=[，、：:])", "match_group": 1, "desc": "分项连接词" }
      ]
    },

    "W5": {
      "name": "对冲与填充",
      "severity": "mid",
      "hint": "一层不确定就够了。要么说「可能」，要么说清楚不确定在哪。",
      "words": [
        "在一定程度上", "某种程度上", "或许可能", "可能会存在", "似乎有可能",
        "在某种意义上", "一定的", "相应的", "相关的", "有关的",
        "由于……的原因", "出于……的考虑", "众所周知", "不言而喻"
      ],
      "regex": [
        { "pattern": "(可能|或许|大概|似乎|也许)[^，。！？]{0,6}(可能|或许|大概|似乎|也许)", "desc": "对冲叠加" },
        { "pattern": "可以认为[^，。！？]{0,12}(可能|或许|大致)", "desc": "对冲叠加" }
      ]
    },

    "C4": {
      "name": "替读者说蠢话",
      "severity": "high",
      "hint": "除非真听过有人这么说，否则删掉，直接说你的观点。",
      "words": [
        "你可能觉得", "你可能会觉得", "你可能认为", "你或许认为", "你是不是觉得",
        "很多人以为", "很多人认为", "大多数人认为", "大家都以为", "人们往往认为",
        "普遍的看法是", "常见的误解是", "一种流行的观点是", "有人会说", "也有人认为",
        "甚至有人质疑", "你以为", "别以为"
      ]
    },

    "C5": {
      "name": "模糊归因",
      "severity": "high",
      "hint": "能点名就点名（机构、日期、报告名）。点不了名就删掉这句。绝对不许编来源。",
      "words": [
        "有研究表明", "研究显示", "研究表明", "数据显示", "有数据表明",
        "业内人士指出", "业内人士认为", "有分析人士认为", "分析师普遍认为",
        "专家认为", "专家指出", "专家表示", "有专家称",
        "市场普遍预期", "市场普遍认为", "机构普遍认为", "普遍观点认为",
        "多份报告显示", "相关报告指出", "有报道称", "据了解", "据悉", "据统计",
        "众多学者", "不少观察者", "观察人士"
      ]
    },

    "C7": {
      "name": "升维与权威腔",
      "severity": "high",
      "hint": "停在具体层面。这个话题真的需要升维吗？",
      "words": [
        "本质上", "本质是", "从本质上讲", "归根结底", "说到底", "究其根本", "究其原因",
        "追根溯源", "从更深层", "深层次的原因", "深层逻辑", "底层逻辑", "第一性原理",
        "真正的问题在于", "真正重要的是", "核心在于", "关键在于", "问题的核心",
        "更深层次地看", "从更宏观的视角", "拉长时间维度看"
      ]
    },

    "C8": {
      "name": "夸大意义与宏大叙事",
      "severity": "high",
      "hint": "说事实本身。发生了什么，什么时候，多大规模。",
      "words": [
        "标志着", "意味着一个", "开启了", "拉开了序幕", "翻开了新的一页", "新的篇章",
        "里程碑", "划时代", "历史性", "具有重要意义", "具有深远意义", "深远影响",
        "见证了", "书写了", "铸就了", "奠定了基础", "奠定了坚实基础",
        "时代浪潮", "时代背景下", "历史进程", "宏大叙事", "重塑了", "深刻改变了",
        "不可逆转", "势不可挡", "大势所趋", "缩影", "写照"
      ]
    },

    "C9": {
      "name": "宣传腔与商业黑话",
      "severity": "high",
      "hint": "换成具体动作和具体事实。",
      "words": [
        "赋能", "闭环", "抓手", "颗粒度", "对齐", "拉齐", "打法", "心智", "势能",
        "生态位", "组合拳", "护城河", "降维打击", "认知升级", "破局", "破圈", "出圈",
        "遥遥领先", "断层领先", "天花板", "王炸", "绝了", "封神", "神仙", "yyds",
        "惊艳", "震撼", "炸裂", "碾压", "吊打", "秒杀",
        "一站式", "全链路", "深度赋能", "高效协同", "价值共创", "生态闭环"
      ]
