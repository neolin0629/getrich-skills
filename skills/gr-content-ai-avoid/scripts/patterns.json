{
  "version": "1.0",
  "_note": "gr-content-ai-avoid 的唯一数据源。check.py 读取本文件。改词表只改这里，references/cn-ai-words.md 只做分类说明不复制词表。",
  "_severity": { "high": "🔴 强信号", "mid": "⚠️ 中信号", "low": "💡 弱信号" },

  "lexicon": {
    "W1": {
      "name": "AI 高频词",
      "severity": "high",
