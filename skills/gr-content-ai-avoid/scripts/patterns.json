          "pattern": "[^，。！？]{2,12}的(底层逻辑|第一性原理|本质)[是在]",
          "desc": "……的底层逻辑是"
        }
      ]
    },
    "P1": {
      "name": "开头三件套",
      "severity": "low",
      "hint": "从你真正想说的那件事开始。不卖焦虑，不承诺收获。",
      "scope": "head",
      "head_chars": 150,
      "patterns": [
        {
          "pattern": "你是不是(也)?(经常|总是|常常|遇到过)",
          "desc": "钩子：你是不是经常……"
        },
        {
          "pattern": "有没有(发现|想过|遇到过)",
          "desc": "钩子：有没有发现……"
        },
        {
          "pattern": "(为什么|凭什么)[^。！？]{2,20}(却|但)[^。！？]{2,20}[？?]",
          "desc": "钩子：为什么 X 却 Y？"
        },
        {
          "pattern": "(读完|看完)(这篇|本文|这条)[^。！？]{0,20}(你将|你会|就能|你就)",
          "desc": "承诺：读完你将……"
        },
        {
          "pattern": "(其实|真相是|问题(就)?出在)[^。！？]{2,20}",
          "desc": "痛点归因：其实是因为……"
        },
        {
          "pattern": "(今天|本文|这篇)(就)?(来|和你|跟大家)(聊|说|讲|分享)",
          "desc": "预告式开场"
        }
      ]
    },
    "P5": {
      "name": "结论包装成协议",
      "severity": "mid",
      "hint": "议论类内容别硬凑清单。",
      "scope": "tail",
      "tail_chars": 400,
      "patterns": [
        {
          "pattern": "([三四五六]|[3-6])(条|个|点|大)(原则|逻辑|建议|启示|要点|心法|铁律|法则)",
          "desc": "N 条原则"
        },
        {
          "pattern": "记住(这)?[三四五六3-6](点|条|个)",
          "desc": "记住这几点"
        }
      ]
    },
    "P6": {
      "name": "内联小标题竖排列表",
      "severity": "mid",
      "hint": "先确认列表是否承担导航；最小改写时保留结构，只精简重复内容，不默认合并成段落。",
      "line_patterns": [
        {
          "pattern": "^\\s*[-*+]\\s*\\*\\*[^*]{1,14}\\*\\*\\s*[：:]",
          "desc": "- **标题：** 内容"
        },
        {
          "pattern": "^\\s*[-*+]\\s*\\*\\*[^*]{1,14}[：:]\\*\\*",
          "desc": "- **标题：** 内容"
        }
      ],
      "min_consecutive": 3
    },
    "R2": {
      "name": "情绪叙事精度候选",
      "severity": "low",
      "hint": "核对是否有真实记录。实测数据保留；没有来源时不得另编数字或感受。",
      "patterns": [
        {
          "pattern": "(?:那一?(?:瞬间|刻|秒)|心头一紧|愣了|停顿了)[^。！？\\n]{0,12}\\d+(?:\\.\\d+)?\\s*秒|\\d+(?:\\.\\d+)?\\s*秒[^。！？\\n]{0,8}(?:心头一紧|愣住|心跳加速)",
          "desc": "情绪叙事中的时间精度候选"
        }
      ]
    },
    "R4": {
      "name": "故事来源候选",
      "severity": "low",
      "hint": "匿名故事不等于虚构。核对用户提供的事实，不要求姓名或额外细节，不替换为虚构的第一人称经历。",
      "patterns": [
        {
          "pattern": "我(有)?(一)?个(朋友|同事|读者|学员|客户)",
          "desc": "我有个朋友"
        },
        {
          "pattern": "(认识|遇到过)(一)?个(人|朋友|老板)",
          "desc": "认识一个人"
        }
      ]
    },
    "R5": {
      "name": "用身体感受替代论证",
      "severity": "low",
      "patterns": [
        {
          "pattern": "身体(会|早就|自然会)?(给出|知道|告诉)",
          "desc": "身体会给出答案"
        },
        {
          "pattern": "你(会|能)感觉到",
          "desc": "你会感觉到"
        },
        {
          "pattern": "(那种感觉|直觉)(是)?骗不了(人|你)",
          "desc": "感觉骗不了人"
        }
      ]
    },
    "P4": {
      "name": "结尾套话候选",
      "severity": "low",
      "hint": "核对结尾是否泛化重复。正常祝福、原文引用和用户指定收尾应保留。",
      "scope": "tail",
      "tail_chars": 200,
      "patterns": [
        {
          "pattern": "希望对你有帮助|一切都会好起来|与君共勉|一起加油|一起变好|愿每一个|点亮在看|未来可期|行则将至|愿我们|你值得|愿你|共勉",
          "desc": "尾部套话候选"
        }
      ]
    }
  },
  "metrics": {
    "S2_sentence_cv": {
      "name": "句长变异系数",
      "severity": "low",
      "hint": "仅描述正文句长分布，不判断作者或质量，不为改变 CV 调整句子。",
      "min_sentences": 8
    },
    "S7_punchline_rate": {
      "name": "段末短句比例",
      "severity": "low",
      "hint": "短句不等于金句，检查实际收尾是否机械重复；不要仅按比例改写。",
      "warn_above": 0.6,
      "min_paragraphs": 4
    },
    "S7_staccato_run": {
      "name": "连续短句",
      "severity": "mid",
      "hint": "只提示同一段内的短句聚集；真实节奏、事实步骤和必要强调可保留。",
      "max_len": 8,
      "min_run": 3
    },
    "F1_dash_per_1k": {
      "name": "破折号密度",
      "severity": "mid",
      "hint": "按解释、插入语和转折功能复核；保留合法标点和作者习惯，不按固定顺序替换。",
      "warn_above": 2.0,
      "min_allowed_count": 1
    },
    "F2_bold_per_1k": {
      "name": "粗体密度",
      "severity": "mid",
      "hint": "保留导航与有效强调，只减少无功能的机械加粗，不设置一屏一处配额。",
      "warn_above": 6.0,
      "min_allowed_count": 1,
      "genre_override": {
        "xhs-short": 12.0,
        "xhs-long": 12.0
      }
    },
    "F3_emoji_per_1k": {
      "name": "emoji 密度",
      "severity": "mid",
      "hint": "只减少无导航或表达作用的装饰；保留用户风格，不按图案认定来源。",
      "warn_above": 2.0
    },
    "W1_per_1k": {
      "name": "空泛词候选密度",
      "severity": "high",
      "warn_above": 2.0,
      "min_allowed_count": 2
    }
  },
  "genres": {
    "default": {
      "strict": [],
      "skip": []
    },
    "wechat": {
      "strict": ["S7_punchline_rate", "P5", "C7"],
      "skip": []
    },
    "xhs-short": {
      "strict": ["P1", "P4", "C9"],
      "skip": ["S2_sentence_cv", "F3_emoji_per_1k", "S7_punchline_rate"]
    },
    "xhs-long": {
      "strict": ["P1", "P4"],
      "skip": ["F3_emoji_per_1k", "P6"]
    },
    "weibo": {
      "strict": ["P1", "P4"],
      "skip": ["S2_sentence_cv", "S7", "P6"]
    },
    "zhihu": {
      "strict": ["C5", "C2"],
      "skip": []
    },
    "video": {
      "strict": ["P1", "W3"],
      "skip": ["S7_punchline_rate", "S7_staccato_run", "P2"]
    },
    "persona": {
      "strict": ["R2", "R4", "P4"],
      "skip": ["S2_sentence_cv", "F3_emoji_per_1k", "S7_punchline_rate", "S7_staccato_run"]
    },
    "copy": {
      "strict": ["C9", "C5"],
      "skip": ["S7_punchline_rate", "R1", "S7_staccato_run"]
    },
    "quant": {
      "strict": ["C5", "F5", "R1", "C7"],
      "skip": []
    },
    "academic": {
      "strict": ["W1", "W2", "S5", "F1_dash_per_1k", "C5"],
      "skip": ["C4", "S7_punchline_rate", "S7_staccato_run", "R1", "R2", "R4", "R5", "P5", "C1", "C2", "R3"]
    }
  },
  "manual_rules": {
    "S1": "人工核对凑项、冗余和相邻句式重复；三项、等长本身不触发，完整清单不得漏项。",
    "W4": "同义词是否改变概念或重复表达。",
    "C1": "预先回应是否相关、有依据，避免虚构稻草人。",
    "C2": "术语和数据是否服务于读者需要。",
    "C3": "让步模板是否重复且没有新信息。",
    "C6": "命名是否有解释价值。",
    "R1": "核对真实判断边界；量化内容检查样本、市场、成本和方法限制，不用关键词证明充分。",
    "R3": "经历是否来自用户或可靠材料；无需补写无关细节。"
  }
}
